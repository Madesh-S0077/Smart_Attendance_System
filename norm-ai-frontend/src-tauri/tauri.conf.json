{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Norm AI",
  "version": "1.0.0",
  "identifier": "ac.in.rmkec.normai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Norm AI — Smart Attendance",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:8000 http://127.0.0.1:8765"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [
      "sidecar/ai_pipeline"
    ]
  },
  "plugins": {
    "shell": {
      "open": true,
      "sidecar": true
    },
    "store": {}
  }
}
